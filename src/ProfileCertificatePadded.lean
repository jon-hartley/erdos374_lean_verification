def paddedTransitionCheck (prior : List ℕ) : List (List ℕ) → List ℕ → List ℕ → Bool
  | [], [], [] => true
  | row::rows, f::fs, v::vs =>
      decide (scale*f + scale*(scale/10000) + scale*(scale/100000) +
        weightedDifferences row prior ≤ scale*v) &&
      paddedTransitionCheck prior rows fs vs
  | _, _, _ => false

