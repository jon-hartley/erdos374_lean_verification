/-! ## 62. Repair 63: attack the five elementary finite-field frontier statements

The corrected legal root-cover adapters are green.  This repair starts proving
the five remaining elementary/library-facing facts directly.

We deliberately do not touch the deep `AnchorQuadraticWeil59` theorem here.
-/

namespace RemainingAnalytic63

open scoped BigOperators
open RemainingAnalytic37 RemainingAnalytic59 RemainingAnalytic61 RemainingAnalytic62

/-! -------------------------------------------------------------------------
A. Product root bounds from generic product-zero membership
------------------------------------------------------------------------- -/

/-- Generic finite-product fact: if a product over a finite set vanishes in an
integral domain, then one factor vanishes. -/
theorem prod_eq_zero_mem63
    {R : Type*} [CommRing R] [Nontrivial R] [NoZeroDivisors R]
    {ι : Type*} [DecidableEq ι]
    (s : Finset ι) (f : ι → R)
    (h : ∏ i ∈ s, f i = 0) :
    ∃ i ∈ s, f i = 0 := by
  classical
  simpa using Finset.prod_eq_zero_iff.mp h

/-- A root of the I-product comes from some displayed index i. -/
theorem anchorIRoot_mem_factor63
    {r ell lam z : ℕ}
    (hp : lam.Prime)
    (hz :
      anchorIProduct61 r ell lam (z : ZMod lam) = 0) :
    ∃ i ∈ (Finset.range ell).filter (fun i => 1 ≤ i),
      ((r : ZMod lam) * (z : ZMod lam) - (i : ZMod lam)) = 0 := by
  letI : Fact lam.Prime := ⟨hp⟩
  unfold anchorIProduct61 at hz
  exact prod_eq_zero_mem63
    ((Finset.range ell).filter (fun i => 1 ≤ i))
    (fun i => ((r : ZMod lam) * (z : ZMod lam) - (i : ZMod lam)))
    hz

/-- A root of the V-product comes from one displayed v ≠ t. -/
theorem anchorVRoot_mem_factor63
    {j t h lam z : ℕ}
    (hp : lam.Prime)
    (hz :
      anchorVProduct61 j t h lam (z : ZMod lam) = 0) :
    ∃ v ∈ (Finset.range h).filter (fun v => v ≠ t),
      ((j : ZMod lam) * (z : ZMod lam) + (t : ZMod lam) - (v : ZMod lam)) = 0 := by
  letI : Fact lam.Prime := ⟨hp⟩
  unfold anchorVProduct61 at hz
  exact prod_eq_zero_mem63
    ((Finset.range h).filter (fun v => v ≠ t))
    (fun v => ((j : ZMod lam) * (z : ZMod lam) + (t : ZMod lam) - (v : ZMod lam)))
    hz

/-! -------------------------------------------------------------------------
B. Root uniqueness for a fixed displayed factor
------------------------------------------------------------------------- -/

theorem zmod_natCast_ne_zero_of_pos_lt63
    {lam n : ℕ} (hp : lam.Prime) (hn0 : 0 < n) (hnlt : n < lam) :
    (n : ZMod lam) ≠ 0 := by
  intro hz
  have hdiv : lam ∣ n := (ZMod.natCast_eq_zero_iff n lam).mp hz
  have hle : lam ≤ n := Nat.le_of_dvd hn0 hdiv
  omega

theorem r_nonzero_mod63
    {r j h ell lam : ℕ}
    (hp : lam.Prime)
    (hj : 0 < j) (hjr : j < r)
    (hh : 0 < h) (hell : 0 < ell)
    (hsep : 2 * r * max h ell < lam) :
    (r : ZMod lam) ≠ 0 := by
  have hrpos : 0 < r := lt_trans hj hjr
  have hH : 1 ≤ max h ell := by omega
  have hr_le_prod : r ≤ 2 * r * max h ell := by
    nlinarith
  have hrlt : r < lam := lt_of_le_of_lt hr_le_prod hsep
  exact zmod_natCast_ne_zero_of_pos_lt63 hp hrpos hrlt

theorem j_nonzero_mod63
    {r j h ell lam : ℕ}
    (hp : lam.Prime)
    (hj : 0 < j) (hjr : j < r)
    (hh : 0 < h) (hell : 0 < ell)
    (hsep : 2 * r * max h ell < lam) :
    (j : ZMod lam) ≠ 0 := by
  have hH : 1 ≤ max h ell := by omega
  have hr_le_prod : r ≤ 2 * r * max h ell := by
    have hrpos : 0 < r := lt_trans hj hjr
    nlinarith
  have hrlt : r < lam := lt_of_le_of_lt hr_le_prod hsep
  exact zmod_natCast_ne_zero_of_pos_lt63 hp hj (lt_trans hjr hrlt)

/-- Fixed I-factor has at most one residue root. -/
theorem anchorIFactor_root_unique63
    {r i lam z1 z2 : ℕ}
    (hp : lam.Prime)
    (hr0 : (r : ZMod lam) ≠ 0)
    (hz1lt : z1 < lam) (hz2lt : z2 < lam)
    (h1 : (r : ZMod lam) * (z1 : ZMod lam) - (i : ZMod lam) = 0)
    (h2 : (r : ZMod lam) * (z2 : ZMod lam) - (i : ZMod lam) = 0) :
    z1 = z2 := by
  letI : Fact lam.Prime := ⟨hp⟩
  have heq1 :
      (r : ZMod lam) * (z1 : ZMod lam) = (i : ZMod lam) :=
    sub_eq_zero.mp h1
  have heq2 :
      (r : ZMod lam) * (z2 : ZMod lam) = (i : ZMod lam) :=
    sub_eq_zero.mp h2
  have hzmod : (z1 : ZMod lam) = (z2 : ZMod lam) :=
    mul_left_cancel₀ hr0 (heq1.trans heq2.symm)
  have hmods : z1 % lam = z2 % lam :=
    (ZMod.natCast_eq_natCast_iff' z1 z2 lam).mp hzmod
  simpa [Nat.mod_eq_of_lt hz1lt, Nat.mod_eq_of_lt hz2lt] using hmods

/-- Fixed V-factor has at most one residue root. -/
theorem anchorVFactor_root_unique63
    {j t v lam z1 z2 : ℕ}
    (hp : lam.Prime)
    (hj0 : (j : ZMod lam) ≠ 0)
    (hz1lt : z1 < lam) (hz2lt : z2 < lam)
    (h1 :
      (j : ZMod lam) * (z1 : ZMod lam) + (t : ZMod lam) - (v : ZMod lam) = 0)
    (h2 :
      (j : ZMod lam) * (z2 : ZMod lam) + (t : ZMod lam) - (v : ZMod lam) = 0) :
    z1 = z2 := by
  letI : Fact lam.Prime := ⟨hp⟩
  have heq1 :
      (j : ZMod lam) * (z1 : ZMod lam) + (t : ZMod lam) =
        (v : ZMod lam) :=
    sub_eq_zero.mp h1
  have heq2 :
      (j : ZMod lam) * (z2 : ZMod lam) + (t : ZMod lam) =
        (v : ZMod lam) :=
    sub_eq_zero.mp h2
  have hmul :
      (j : ZMod lam) * (z1 : ZMod lam) =
        (j : ZMod lam) * (z2 : ZMod lam) := by
    exact add_right_cancel (heq1.trans heq2.symm)
  have hzmod : (z1 : ZMod lam) = (z2 : ZMod lam) :=
    mul_left_cancel₀ hj0 hmul
  have hmods : z1 % lam = z2 % lam :=
    (ZMod.natCast_eq_natCast_iff' z1 z2 lam).mp hzmod
  simpa [Nat.mod_eq_of_lt hz1lt, Nat.mod_eq_of_lt hz2lt] using hmods

/-! -------------------------------------------------------------------------
C. Cardinality bounds via assignment of each root to one factor
------------------------------------------------------------------------- -/

/-- A general finite-root cover lemma: if every x in roots is assigned to an
index i in idx and each fixed i has at most one x, then card roots <= card idx.
-/
theorem card_le_of_unique_factor63
    {α β : Type*} [DecidableEq α] [DecidableEq β] [Nonempty β]
    (roots : Finset α) (idx : Finset β)
    (R : α → β → Prop) [DecidableRel R]
    (hex : ∀ x ∈ roots, ∃ i ∈ idx, R x i)
    (huniq : ∀ i ∈ idx, ∀ x1 ∈ roots, ∀ x2 ∈ roots,
      R x1 i → R x2 i → x1 = x2) :
    roots.card ≤ idx.card := by
  classical
  let chooseIdx : α → β := fun x =>
    if hx : x ∈ roots then Classical.choose (hex x hx) else Classical.choice inferInstance
  have hchoose_mem :
      ∀ x ∈ roots, chooseIdx x ∈ idx := by
    intro x hx
    simp [chooseIdx, hx, Classical.choose_spec (hex x hx)]
  have hinj :
      Set.InjOn chooseIdx ↑roots := by
    intro x1 hx1 x2 hx2 heq
    have hx1' : x1 ∈ roots := by simpa using hx1
    have hx2' : x2 ∈ roots := by simpa using hx2
    let i := chooseIdx x1
    have hi : i ∈ idx := hchoose_mem x1 hx1'
    have hR1 : R x1 i := by
      dsimp [i, chooseIdx]
      simp [hx1']
      exact (Classical.choose_spec (hex x1 hx1')).2
    have hR2choose : R x2 (chooseIdx x2) := by
      simp only [chooseIdx, dif_pos hx2']
      exact (Classical.choose_spec (hex x2 hx2')).2
    have hi2eq : chooseIdx x2 = i := by
      simpa [i] using heq.symm
    rw [hi2eq] at hR2choose
    have hR2 : R x2 i := hR2choose
    exact huniq i hi x1 hx1' x2 hx2' hR1 hR2
  exact Finset.card_le_card_of_injOn
    (f := chooseIdx) hchoose_mem hinj

theorem anchorIProductRootBoundLegal_proved63 :
    AnchorIProductRootBoundLegal62 := by
  intro a r j t h ell lam hj hjr hh hell ht hp ha hsep
  let roots := anchorIRoots61 r ell lam
  let idx := (Finset.range ell).filter (fun i => 1 ≤ i)
  have hr0 := r_nonzero_mod63 hp hj hjr hh hell hsep
  have hcard :
      roots.card ≤ idx.card := by
    apply card_le_of_unique_factor63
      roots idx
      (fun z i =>
        ((r : ZMod lam) * (z : ZMod lam) - (i : ZMod lam)) = 0)
    · intro z hz
      have hz' := Finset.mem_filter.mp hz
      exact anchorIRoot_mem_factor63 hp hz'.2
    · intro i hi z1 hz1 z2 hz2 h1 h2
      have hz1lt := Finset.mem_range.mp (Finset.mem_filter.mp hz1).1
      have hz2lt := Finset.mem_range.mp (Finset.mem_filter.mp hz2).1
      exact anchorIFactor_root_unique63 hp hr0 hz1lt hz2lt h1 h2
  calc
    (anchorIRoots61 r ell lam).card = roots.card := rfl
    _ ≤ idx.card := hcard
    _ ≤ ell := by
      dsimp [idx]
      exact le_trans
        (Finset.card_filter_le (Finset.range ell) (fun i => 1 ≤ i))
        (by simp)

theorem anchorVProductRootBoundLegal_proved63 :
    AnchorVProductRootBoundLegal62 := by
  intro a r j t h ell lam hj hjr hh hell ht hp ha hsep
  let roots := anchorVRoots61 j t h lam
  let idx := (Finset.range h).filter (fun v => v ≠ t)
  have hj0 := j_nonzero_mod63 hp hj hjr hh hell hsep
  have hcard :
      roots.card ≤ idx.card := by
    apply card_le_of_unique_factor63
      roots idx
      (fun z v =>
