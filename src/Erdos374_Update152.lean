/-- The whole exceptional difference is density zero from the reduced input
record.  This replaces the old assumed `short_four`, `short_five`, and
`two_three` fields by derived theorems. -/
theorem difference_densityZero15 (H : RemainingProofs15) :
    DensityZero (B alpha \ D6) := by
  classical
  obtain ⟨E, hEzero, N, hpack⟩ :=
    final_gap_exclusion_package
      H.short_second H.factorial_growth H.direct_dominance
      H.interval_comparison H.short_gap_dominance
  let Bad : Set ℕ :=
    {m : ℕ | ¬ Composite m} ∪
      (E ∪ (Initial N ∪
        (NonpairedFour alpha eta ∪ NonpairedFive alpha eta)))
  have hBadZero : DensityZero Bad := by
    dsimp [Bad]
    exact densityZero_union H.noncomposite_zero
      (densityZero_union hEzero
        (densityZero_union (densityZero_initial N)
          (densityZero_union H.anchor_four_zero H.anchor_five_zero)))
  apply densityZero_mono (T := Bad) ?_ hBadZero
  intro m hm
  by_contra hbad
  have hc : Composite m := by
    by_contra hnc
    exact hbad (Or.inl hnc)
  have hE : m ∉ E := by
    intro he
    exact hbad (Or.inr (Or.inl he))
  have hN : N ≤ m := by
    by_contra hn
    have hi : m ∈ Initial N := by
      change m < N
      omega
    exact hbad (Or.inr (Or.inr (Or.inl hi)))
  have h4 : m ∉ NonpairedFour alpha eta := by
    intro hh
    exact hbad (Or.inr (Or.inr (Or.inr (Or.inl hh))))
  have h5 : m ∉ NonpairedFive alpha eta := by
    intro hh
    exact hbad (Or.inr (Or.inr (Or.inr (Or.inr hh))))
  have hp := hpack m hN hE
  have hno : ∀ k : ℕ, 2 ≤ k → k < 6 → ¬ HasRep m k := by
    intro k hk hk6 hrep
    interval_cases k
    · exact (hp.2.2 hm.1).1 hrep
    · exact (hp.2.2 hm.1).2 hrep
    · obtain ⟨b, c, d, hr⟩ := four_of_hasRep hrep
      have hg := hp.1 b c d hr
      by_cases hpair : c - b = 1 ∧ m - d = 1
      · exact paired_four_proved m b c d hm.1.1 hr hpair.1 hpair.2
      · have hnp : c - b ≠ 1 ∨ m - d ≠ 1 := by tauto
        exact h4 ⟨hm.1.2, b, c, d, hr, hnp,
          le_of_lt hg.1, le_of_lt hg.2⟩
    · obtain ⟨a, b, c, d, hr⟩ := five_of_hasRep hrep
      have hg := hp.2.1 a b c d hr
      by_cases hpair : c - b = 1 ∧ m - d = 1
      · exact paired_five_proved m a b c d hm.1.1 hr hpair.1 hpair.2
      · have hnp : c - b ≠ 1 ∨ m - d ≠ 1 := by tauto
        exact h5 ⟨hm.1.2, a, b, c, d, hr, hnp,
          le_of_lt hg.1, le_of_lt hg.2⟩
  exact hm.2 (mem_D6_of_composite_exclusions hc hno)

