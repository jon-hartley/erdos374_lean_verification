        2 * ‖a m‖ * ‖a n‖ * (1 / |Real.log m - Real.log n|) := by
      apply Finset.sum_congr rfl
      intro m hm
      rw [← Finset.sum_erase (a := m) (s := s)
        (by simp : 2 * ‖a m‖ * ‖a m‖ * (1 / |Real.log m - Real.log m|) = (0 : ℝ))]
      apply Finset.sum_congr rfl
      intro n hn
      ring
