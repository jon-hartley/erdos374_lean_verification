      100 * ((c - b : ℕ) : ℝ) * (Real.log (X : ℝ)) ^ 2 < (b : ℝ) →
      True

/-- §4.3: lower bound on the correlated continuous main term (4.4). -/
def CorrelatedIntegralLowerBound : Prop :=
  ∀ γ : ℝ, 0 < γ → γ < 1 → ∃ X₀ : ℕ,
    ∀ X b h : ℕ, X₀ ≤ X → 0 < h → b ≤ X →
      (X : ℝ) ^ γ ≤ (h : ℝ) →
      True

/-- §4.4: Proposition 2.1 transfers the correlated integral mass to primes
with an error negligible compared with h/log P. -/
def ReciprocalPrimeTransfer : Prop :=
  ∀ γ : ℝ, 0 < γ → γ < 1 → ∃ X₀ : ℕ,
    ∀ X a b c : ℕ, X₀ ≤ X → a < b → b < c → c ≤ X →
      (X : ℝ) ^ γ ≤ ((c - b : ℕ) : ℝ) →
      True

/-- The sparse-branch source ingredients imply the precise sparse branch
already used by Repair 19. -/
def SparseBranchAssembly : Prop :=
  SparseCutoffGeometry →
  CorrelatedIntegralLowerBound →
  ReciprocalPrimeTransfer →
  RemainingAnalytic19.ValuationOneMassSparse

