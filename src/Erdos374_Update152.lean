    have hCbound : C ≤ K * (1 - q) := by
      field_simp [ne_of_gt hden] at hmul
      nlinarith
    nlinarith
  have hbaseK : B ≤ K * base := by
    have hBK : B / base + 1 ≤ K := le_max_right _ _
    have hmul := mul_le_mul_of_nonneg_right hBK (le_of_lt hbase)
    field_simp [ne_of_gt hbase] at hmul
    nlinarith
  have hstrong :
      ∀ X : ℕ, N0 ≤ X →
