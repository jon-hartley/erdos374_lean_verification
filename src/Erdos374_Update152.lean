      (RemainingAnalytic37.AnchorSquareResidueCount a r j t h ell lam : ℝ) ≤ 3 * (lam : ℝ) := by
    nlinarith only [hbridge, hchar, hzR, hprod, hs2, hsizeR, hHsq]
