/-! ## 25. Repair 26: anchor root-list obstruction for Proposition 5.1

This repair formalizes the combinatorial root argument in manuscript §5.
It deliberately stops one step before the polynomial-algebra statement
"not a scalar multiple of a square": that bridge will be the next repair.

The two rational root families from (5.7) are encoded as predicates rather
than multisets.  Outside the paired case `(h, ell) = (1,1)`, and under the
actual tuple restrictions `0 < j < r`, `t < h`, `0 < h`, `0 < ell`, we prove
that one of the two root families contains a rational root absent from the
other family.
-/

namespace RemainingAnalytic26

/-- First root family in (5.7): `i/r`, `1 <= i < ell`. -/
def LowerAnchorRoot (r ell : ℕ) (x : ℚ) : Prop :=
  ∃ i : ℕ, 1 ≤ i ∧ i < ell ∧ x = (i : ℚ) / (r : ℚ)

/-- Second root family in (5.7): `(v-t)/j`, `0 <= v < h`, `v != t`.
The subtraction is performed in `ℚ`, as in the manuscript. -/
def UpperAnchorRoot (j t h : ℕ) (x : ℚ) : Prop :=
  ∃ v : ℕ, v < h ∧ v ≠ t ∧
    x = ((v : ℚ) - (t : ℚ)) / (j : ℚ)

/-- The exact root-list obstruction used to show that the anchor polynomial
has an odd-multiplicity root. -/
def AnchorRootMismatch (r j t h ell : ℕ) : Prop :=
  ∃ x : ℚ,
    (LowerAnchorRoot r ell x ∧ ¬ UpperAnchorRoot j t h x) ∨
    (UpperAnchorRoot j t h x ∧ ¬ LowerAnchorRoot r ell x)

end RemainingAnalytic26

/-- If `t>0`, the root `-t/j` occurs in the second list (take `v=0`) and
cannot occur in the positive first list. -/
theorem anchor_root_mismatch_of_t_pos
    {r j t h ell : ℕ}
    (hj : 0 < j) (ht : 0 < t) (hth : t < h) :
    RemainingAnalytic26.AnchorRootMismatch r j t h ell := by
  refine ⟨-((t : ℚ) / (j : ℚ)), Or.inr ?_⟩
  constructor
  · refine ⟨0, ?_, ?_, ?_⟩
    · omega
    · omega
    · have hjq : (j : ℚ) ≠ 0 := by exact_mod_cast (Nat.ne_of_gt hj)
      field_simp [hjq]
      ring
  · intro hlow
    rcases hlow with ⟨i, hi1, hiell, hroot⟩
    have hij : (0 : ℚ) < (i : ℚ) := by exact_mod_cast (show 0 < i by omega)
    have hjq : (0 : ℚ) < (j : ℚ) := by exact_mod_cast hj
    have hr_nonneg : (0 : ℚ) ≤ (r : ℚ) := by exact_mod_cast (Nat.zero_le r)
    have htq : (0 : ℚ) < (t : ℚ) := by exact_mod_cast ht
    have hquotpos : (0 : ℚ) < (t : ℚ) / (j : ℚ) := div_pos htq hjq
    have hxneg : -((t : ℚ) / (j : ℚ)) < 0 := neg_lt_zero.mpr hquotpos
    have hxnonneg : (0 : ℚ) ≤ (i : ℚ) / (r : ℚ) :=
      div_nonneg (le_of_lt hij) hr_nonneg
    rw [hroot] at hxneg
    linarith

/-- When `t=0` and the first list is empty (`ell=1`), the root `1/j`
from `v=1` is present in the second list as soon as the case is nonpaired. -/
theorem anchor_root_mismatch_of_t_zero_ell_one
    {r j t h ell : ℕ}
    (hj : 0 < j) (ht0 : t = 0) (hell1 : ell = 1)
    (hh : 0 < h) (hnpaired : h ≠ 1 ∨ ell ≠ 1) :
    RemainingAnalytic26.AnchorRootMismatch r j t h ell := by
  have hh2 : 2 ≤ h := by
    by_contra hnot
    have hh1 : h = 1 := by omega
    exact hnpaired.elim (fun hne => hne hh1) (fun hne => hne hell1)
  refine ⟨(1 : ℚ) / (j : ℚ), Or.inr ?_⟩
  constructor
  · refine ⟨1, ?_, ?_, ?_⟩
    · omega
    · omega
    · subst t
      norm_num
  · intro hlow
    rcases hlow with ⟨i, hi1, hiell, hroot⟩
    omega

/-- When `t=0` and the first list is nonempty, its first root `1/r` cannot
occur in the second list because `0<j<r`; this is exactly the root-separation
calculation already isolated earlier in the file. -/
theorem anchor_root_mismatch_of_t_zero_ell_ge_two
    {r j t h ell : ℕ}
    (hj : 0 < j) (hjr : j < r) (ht0 : t = 0)
    (hell2 : 2 ≤ ell) :
    RemainingAnalytic26.AnchorRootMismatch r j t h ell := by
  refine ⟨(1 : ℚ) / (r : ℚ), Or.inl ?_⟩
  constructor
  · exact ⟨1, by decide, by omega, rfl⟩
  · intro hup
    rcases hup with ⟨v, hvh, hvt, hroot⟩
    subst t
    have hvpos : 1 ≤ v := by omega
    have hne := anchor_first_root_unmatched
      (r := r) (j := j) (v := v) hj hjr hvpos
    apply hne
    simpa using hroot

/-- Complete formalization of the root-list mismatch argument from (5.7).
The only excluded case is precisely `(h,ell)=(1,1)`. -/
theorem anchor_root_mismatch_proved
    {r j t h ell : ℕ}
    (hj : 0 < j) (hjr : j < r)
    (hh : 0 < h) (hell : 0 < ell) (hth : t < h)
    (hnpaired : h ≠ 1 ∨ ell ≠ 1) :
    RemainingAnalytic26.AnchorRootMismatch r j t h ell := by
  by_cases ht0 : t = 0
  · by_cases hell1 : ell = 1
    · exact anchor_root_mismatch_of_t_zero_ell_one
        hj ht0 hell1 hh hnpaired
    · have hell2 : 2 ≤ ell := by omega
      exact anchor_root_mismatch_of_t_zero_ell_ge_two
        hj hjr ht0 hell2
  · have ht : 0 < t := by omega
    exact anchor_root_mismatch_of_t_pos hj ht hth

/-! Repair 26 intentionally does not identify `AnchorRootMismatch` with the
existing Repair-21 placeholder `AnchorPolynomialNonsquare`, whose local payload
was only `True`.  The next repair should replace that placeholder with a genuine
polynomial statement and prove the algebraic bridge: an unmatched simple root
prevents `anchorPolynomial` from being a nonzero scalar multiple of a square.
-/


/-! ## 26. Repair 27: genuine polynomial nonsquare bridge

Repair 26 proved the concrete root-list mismatch from manuscript (5.7).  This
repair upgrades the formal statement on the polynomial side: a polynomial
with a simple rational root cannot be a nonzero scalar multiple of a square.

The remaining bridge from the Repair-26 root-list mismatch to an actual
`rootMultiplicity = 1` statement for `anchorPolynomial` is isolated explicitly
as `AnchorSimpleRoot`.  Thus the old Repair-21 `True` payload is no longer the
mathematical nonsquare statement used here.
-/

namespace RemainingAnalytic27

/-- A genuine polynomial formulation of "not a nonzero scalar times a square". -/
def NotNonzeroScalarSquare (f : Polynomial ℚ) : Prop :=
  ¬ ∃ κ : ℚ, ∃ g : Polynomial ℚ,
      κ ≠ 0 ∧ f = Polynomial.C κ * g ^ 2

/-- The exact simple-root output needed from the root-list analysis. -/
def AnchorSimpleRoot : Prop :=
  ∀ a r j t h ell : ℕ,
    0 < j → j < r → 0 < h → 0 < ell → t < h →
    (h ≠ 1 ∨ ell ≠ 1) →
    ∃ x : ℚ,
      Polynomial.rootMultiplicity x (Tasks.anchorPolynomial a r j t h ell) = 1

/-- Genuine nonsquare statement for the anchor polynomial. -/
def AnchorPolynomialNonsquareGenuine : Prop :=
  ∀ a r j t h ell : ℕ,
    0 < j → j < r → 0 < h → 0 < ell → t < h →
    (h ≠ 1 ∨ ell ≠ 1) →
    NotNonzeroScalarSquare (Tasks.anchorPolynomial a r j t h ell)

end RemainingAnalytic27

/-- Every nonzero scalar multiple of a square has even root multiplicity.
This is the algebraic parity fact behind the manuscript's nonsquare argument. -/
theorem rootMultiplicity_even_of_nonzero_scalar_square
    {f g : Polynomial ℚ} {κ x : ℚ}
    (hκ : κ ≠ 0) (hf : f = Polynomial.C κ * g ^ 2) :
    Even (Polynomial.rootMultiplicity x f) := by
  subst f
  by_cases hg : g = 0
  · subst g
    simp
  · have hC : Polynomial.C κ ≠ (0 : Polynomial ℚ) := by
      simp [hκ]
    have hgg : g * g ≠ (0 : Polynomial ℚ) := mul_ne_zero hg hg
    have hprod : Polynomial.C κ * (g * g) ≠ (0 : Polynomial ℚ) :=
      mul_ne_zero hC hgg
    have hmul1 := Polynomial.rootMultiplicity_mul (x := x) hprod
    have hmul2 := Polynomial.rootMultiplicity_mul (x := x) hgg
    rw [pow_two]
    rw [hmul1, hmul2]
    simp only [Polynomial.rootMultiplicity_C, zero_add]
    refine ⟨Polynomial.rootMultiplicity x g, ?_⟩
    omega

/-- A simple root rules out a nonzero scalar-square representation. -/
theorem notNonzeroScalarSquare_of_rootMultiplicity_one
    {f : Polynomial ℚ} {x : ℚ}
    (hx : Polynomial.rootMultiplicity x f = 1) :
    RemainingAnalytic27.NotNonzeroScalarSquare f := by
  rintro ⟨κ, g, hκ, hf⟩
  have hev : Even (Polynomial.rootMultiplicity x f) :=
    rootMultiplicity_even_of_nonzero_scalar_square hκ hf
  rw [hx] at hev
  norm_num [Even] at hev

/-- The simple-root form of the anchor argument implies the genuine polynomial
nonsquare statement uniformly in every tuple. -/
theorem anchorPolynomialNonsquare_of_simpleRoot
    (H : RemainingAnalytic27.AnchorSimpleRoot) :
    RemainingAnalytic27.AnchorPolynomialNonsquareGenuine := by
  intro a r j t h ell hj hjr hh hell hth hnp
  obtain ⟨x, hx⟩ := H a r j t h ell hj hjr hh hell hth hnp
  exact notNonzeroScalarSquare_of_rootMultiplicity_one hx

/-- Repair 26 supplies the root-list mismatch for every legal nonpaired tuple.
This records the exact remaining local bridge: prove that such a mismatch gives
an actual simple root of `anchorPolynomial`. -/
def RemainingAnalytic27.RootMismatchToSimpleRoot : Prop :=
  ∀ a r j t h ell : ℕ,
    0 < j → j < r → 0 < h → 0 < ell → t < h →
    (h ≠ 1 ∨ ell ≠ 1) →
    RemainingAnalytic26.AnchorRootMismatch r j t h ell →
    ∃ x : ℚ,
      Polynomial.rootMultiplicity x (Tasks.anchorPolynomial a r j t h ell) = 1

/-- The Repair-26 theorem plus the one explicit polynomial-factor bridge gives
`AnchorSimpleRoot`. -/
theorem anchorSimpleRoot_of_rootMismatchBridge
    (H : RemainingAnalytic27.RootMismatchToSimpleRoot) :
    RemainingAnalytic27.AnchorSimpleRoot := by
  intro a r j t h ell hj hjr hh hell hth hnp
  apply H a r j t h ell hj hjr hh hell hth hnp
  exact anchor_root_mismatch_proved hj hjr hh hell hth hnp

/-- Therefore the sole remaining polynomial-algebra step implies the genuine
anchor nonsquare theorem used before good reduction and Weil. -/
theorem anchorPolynomialNonsquareGenuine_of_rootMismatchBridge
    (H : RemainingAnalytic27.RootMismatchToSimpleRoot) :
    RemainingAnalytic27.AnchorPolynomialNonsquareGenuine :=
  anchorPolynomialNonsquare_of_simpleRoot
    (anchorSimpleRoot_of_rootMismatchBridge H)

