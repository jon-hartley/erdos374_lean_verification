          (r : ℝ) * (H : ℝ) ^ 3 *
            (1 + Real.sqrt ((X / r : ℕ) : ℝ) *
              Real.log ((X / r : ℕ) : ℝ)) := by
          apply mul_le_mul_of_nonneg_left ?_ hK
          apply Finset.sum_le_sum_of_subset_of_nonneg
            (Finset.filter_subset _ _)
          intro r hr hrnot
          have hs : 0 ≤ Real.sqrt ((X / r : ℕ) : ℝ) := Real.sqrt_nonneg _
