        ∑ r ∈ Finset.Icc 1 X,
          ((if r ∈ A ∧ ((r : ℝ) ≤ (X : ℝ) ^ alpha) then
              (prefixCount {p : ℕ | p.Prime} (X / r) : ℝ) / (X : ℝ)
            else 0) -
           (if r ∈ A ∧ ((r : ℝ) ≤ (X : ℝ) ^ alpha) then
              (prefixCount {p : ℕ | p.Prime} (r ^ 99) : ℝ) / (X : ℝ)
            else 0)) := by
        apply congrArg ((E : ℝ) / (X : ℝ) + ·)
        apply Finset.sum_congr rfl
        intro r hr
        by_cases hc : r ∈ A ∧ ((r : ℝ) ≤ (X : ℝ) ^ alpha)
        · simp [hc, sub_div]
        · simp [hc]
    _ =
      (E : ℝ) / (X : ℝ) +
        ((∑ r ∈ Finset.Icc 1 X,
            if r ∈ A ∧ ((r : ℝ) ≤ (X : ℝ) ^ alpha) then
              (prefixCount {p : ℕ | p.Prime} (X / r) : ℝ) / (X : ℝ)
            else 0) -
         (∑ r ∈ Finset.Icc 1 X,
            if r ∈ A ∧ ((r : ℝ) ≤ (X : ℝ) ^ alpha) then
              (prefixCount {p : ℕ | p.Prime} (r ^ 99) : ℝ) / (X : ℝ)
            else 0)) := by
        rw [Finset.sum_sub_distrib]
    _ =
