    (hLim : RemainingAnalytic21.AFiniteDensityLimit)
    (hTail : RemainingAnalytic21.AUniformTail) :
    RemainingAnalytic20.ADensityApproximation := by
  refine {
    delta := hLim.delta
    delta_pos := hLim.delta_pos
    approximate := ?_
  }
  intro ε hε
  have he2 : 0 < ε / 2 := by linarith
  let B := max (hLim.cutoff (ε / 2)) (hTail.cutoff (ε / 2))
  let δB := hLim.densityAt B
  have hBL : hLim.cutoff (ε / 2) ≤ B := le_max_left _ _
  have hBT : hTail.cutoff (ε / 2) ≤ B := le_max_right _ _
  refine ⟨B, δB, ?_, ?_, ?_⟩
  · exact hLim.finite_density (ε / 2) he2 B hBL
  · exact lt_trans (hLim.close (ε / 2) he2 B hBL) (by linarith)
  · intro X
    exact lt_trans (hTail.tail (ε / 2) he2 B hBT X) (by linarith)

