theorem referenceIntegral_lower :
    ∃ N : ℕ, 16 ≤ N ∧ ∀ b c P : ℕ,
      N ≤ P → b < c → c - b < P → 16 * P ≤ b →
      ((c - b : ℕ) : ℝ) / (128 * Real.log (2 * (P : ℝ))) ≤
        SmoothSparse144.referenceIntegral b c P := by
  obtain ⟨C, hC0, hC⟩ := square_derivative_bounded
