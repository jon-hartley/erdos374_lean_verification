theorem sample_point_le_integral151 (f g : ℝ → ℝ)
    (hf : Continuous f) (hg : Continuous g) (hfd : Differentiable ℝ f)
    (hd : ∀ t, |deriv f t| ≤ g t) (hg0 : ∀ t, 0 ≤ g t) (r : ℝ) :
