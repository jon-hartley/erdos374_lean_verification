/-- The existing integer-valued quadratic character, cast to the reals. -/
noncomputable def realQuadraticChar138 (x : F) : ℝ := (quadraticChar F x : ℝ)

@[simp] theorem realQuadraticChar_zero138 : realQuadraticChar138 (0 : F) = 0 := by
