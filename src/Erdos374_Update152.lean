/-! ### Dyadic count transfer -/

/-- Exact finite-prefix split at `X/2`. -/
theorem prefixCount_dyadic_split
    (S : Set ℕ) (X : ℕ) :
    prefixCount S X =
      prefixCount S (X / 2) +
      prefixCount (S ∩ {m : ℕ | X / 2 < m ∧ m ≤ X}) X := by
  classical
  unfold prefixCount
  have hhalf : X / 2 ≤ X := Nat.div_le_self X 2
  let A := (Finset.Icc 1 X).filter (fun n => n ∈ S ∧ n ≤ X / 2)
  let B := (Finset.Icc 1 X).filter (fun n => n ∈ S ∧ X / 2 < n)
  have hdisj : Disjoint A B := by
    refine Finset.disjoint_left.mpr ?_
    intro n hnA hnB
    simp only [A, Finset.mem_filter, Finset.mem_Icc] at hnA
    simp only [B, Finset.mem_filter, Finset.mem_Icc] at hnB
    omega
  have hunion :
      A ∪ B = (Finset.Icc 1 X).filter (fun n => n ∈ S) := by
    ext n
    simp only [Finset.mem_union, A, B, Finset.mem_filter, Finset.mem_Icc]
    constructor
    · rintro (⟨hI, hS, hh⟩ | ⟨hI, hS, hh⟩)
      · exact ⟨hI, hS⟩
      · exact ⟨hI, hS⟩
    · rintro ⟨hI, hS⟩
      by_cases hh : n ≤ X / 2
      · exact Or.inl ⟨hI, hS, hh⟩
      · exact Or.inr ⟨hI, hS, lt_of_not_ge hh⟩
  have hcard :
      ((Finset.Icc 1 X).filter (fun n => n ∈ S)).card =
        A.card + B.card := by
    rw [← Finset.card_union_of_disjoint hdisj, hunion]
  have hAset :
      A = (Finset.Icc 1 (X / 2)).filter (fun n => n ∈ S) := by
    ext n
    simp only [A, Finset.mem_filter, Finset.mem_Icc]
    constructor
    · rintro ⟨⟨h1, hXn⟩, hS, hh⟩
      exact ⟨⟨h1, hh⟩, hS⟩
    · rintro ⟨⟨h1, hh⟩, hS⟩
      exact ⟨⟨h1, le_trans hh hhalf⟩, hS, hh⟩
  have hBset :
      B = (Finset.Icc 1 X).filter
          (fun n => n ∈ S ∩ {m : ℕ | X / 2 < m ∧ m ≤ X}) := by
    ext n
    simp only [B, Finset.mem_filter, Finset.mem_Icc, Set.mem_inter_iff,
      Set.mem_setOf_eq]
    constructor
    · rintro ⟨⟨h1, hXn⟩, hS, hh⟩
      exact ⟨⟨h1, hXn⟩, hS, hh, hXn⟩
    · rintro ⟨⟨h1, hXn⟩, hS, hh, _⟩
      exact ⟨⟨h1, hXn⟩, hS, hh⟩
  have hA :
      A.card =
        ((Finset.Icc 1 (X / 2)).filter (fun n => n ∈ S)).card := by
    rw [hAset]
  have hB :
      B.card =
        ((Finset.Icc 1 X).filter
          (fun n => n ∈ S ∩ {m : ℕ | X / 2 < m ∧ m ≤ X})).card := by
    rw [hBset]
  simpa [hA, hB] using hcard

/-- The corrected dyadic transfer used in Repair 33. -/
theorem dyadicPrefixTransfer_proved :
    RemainingAnalytic33.DyadicPrefixTransfer := by
  intro S β logPow hβ0 hβ1 hdy
  obtain ⟨C, hC, N, hN⟩ := hdy
  let q : ℝ := (1 / 2 : ℝ) ^ β
  have hq0 : 0 < q := by dsimp [q]; positivity
  have hq1 : q < 1 := by
    dsimp [q]
