  calc
    ((RemainingAnalytic35.fourCodes X R H).card : ℝ)
        = ((rs.biUnion fun r =>
            RemainingAnalytic36.codesAtRA X H r 0).card : ℝ) := by
              rfl
    _ ≤ ∑ r ∈ rs,
          ((RemainingAnalytic36.codesAtRA X H r 0).card : ℝ) := houter
    _ ≤ ∑ r ∈ rs,
          (r : ℝ) * (H : ℝ) ^ 3 *
            (K * (1 + Real.sqrt ((X / r : ℕ) : ℝ) *
              Real.log ((X / r : ℕ) : ℝ))) := by
          apply Finset.sum_le_sum
          intro r hr
          exact hchild r hr
