                      (r : ℝ) * (H : ℝ) ^ 3 *
                        (1 + Real.sqrt ((X / r : ℕ) : ℝ) *
                          Real.log ((X / r : ℕ) : ℝ)))) := by ring
              _ ≤ CR * (CS * (X : ℝ) ^
                    ((1 : ℝ) / 2 + 3 * α / 2 + 4 * η) *
                    (Real.log (X : ℝ)) ^ 2) :=
