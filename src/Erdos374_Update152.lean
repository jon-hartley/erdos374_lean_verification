    intro m hm n hn heq
    dsimp at heq
    apply Nat.cast_injective (R := ℝ)
    have hm0 : (0 : ℝ) < m := by exact_mod_cast (Nat.zero_lt_of_lt (hs m hm).1)
    have hn0 : (0 : ℝ) < n := by exact_mod_cast (Nat.zero_lt_of_lt (hs n hn).1)
    rw [← Real.exp_log hm0, ← Real.exp_log hn0, heq]
