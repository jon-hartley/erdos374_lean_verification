    · have haNG : a < NG := by omega
      have hNsm : Nsmall ≤ m := by
        dsimp [N] at hX
        have hsmall2 : 2 * Nsmall ≤ X := by omega
        omega
      have hsmall := hNsmall m hNsm
      have hPpow : (m : ℝ) ^ (1 - α) < (P : ℝ) := by
