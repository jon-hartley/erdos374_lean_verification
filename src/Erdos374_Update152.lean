theorem complex_separated_sampling151 (r : Finset ℝ) (D D' : ℝ → ℂ)
    (hD : ∀ t, HasDerivAt D (D' t) t) (hC : Continuous D) (hC' : Continuous D')
    (L : ℝ) (hL : 0 < L)
    (hsep : ∀ x ∈ r, ∀ y ∈ r, x ≠ y → 1 ≤ |x - y|)
    (A B : ℝ) (hAB : A ≤ B) (hr : ∀ t ∈ r, A ≤ t ∧ t ≤ B) :
