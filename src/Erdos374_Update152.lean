    (oddRoots138 U V).card + 2 * (U ∩ V).card = U.card + V.card := by
  have hU : (U \ V).card + (U ∩ V).card = U.card := by
    have hset : (U \ V) ∪ (U ∩ V) = U := by
      ext u
      simp only [Finset.mem_union, Finset.mem_sdiff, Finset.mem_inter]
