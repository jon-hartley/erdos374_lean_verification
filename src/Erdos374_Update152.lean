  let β : ℝ := (1 : ℝ) / 2 + 3 * α / 2 + 4 * η
  have hβ0 : 0 < β := by
    dsimp [β]
    linarith
  have hβ1 : β < 1 := by
    dsimp [β]
    linarith
  have hdy :
      ∃ C : ℝ, 0 < C ∧ ∃ N : ℕ, ∀ X : ℕ, N ≤ X →
