          _ = C * (max h ell : ℕ) * Real.log (X : ℝ) := by ring
      calc
        (a : ℝ) ≤ (NG : ℝ) := haR
        _ ≤ ((NG : ℝ) / Real.log 2) * Real.log (X : ℝ) := hratio
        _ ≤ C * Real.log (X : ℝ) :=
              mul_le_mul_of_nonneg_right hcoef hlog0
        _ ≤ C * (max h ell : ℕ) * Real.log (X : ℝ) := hCH

  refine ⟨T, ?_, ?_, hnpT, ?_, ?_, ?_, ?_⟩
