finite off-diagonal kernel maximum, not an assumed analytic bound. -/
theorem dirichlet_halasz_montgomery152 (s : Finset ℕ) (a : ℕ → ℂ) (r : Finset ℝ) :
    (∑ t ∈ r, ‖exponentialSum151 s a (fun n => Real.log n) t‖ ^ 2) ≤
