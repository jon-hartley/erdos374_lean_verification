theorem coarseAuxiliaryGood141 (α η A0 : ℝ)
    (hα : 0 < α) (hη : 0 < η) (hcond : 3 * α + 8 * η < 1) (hA0 : 0 < A0) :
    ∃ N : ℕ, ∀ X r a h ell lam : ℕ,
