      rw [abs_of_nonneg (sub_nonneg.mpr (by exact_mod_cast hle : (n : ℝ) ≤ m)),
        abs_of_nonneg (sub_nonneg.mpr (Real.log_le_log hn0 (by exact_mod_cast hle)))]
      exact h
