  apply (div_le_div_iff₀ hlog hdist).mpr
  simpa only [one_mul, mul_one, mul_comm] using (div_le_iff₀ hN0).mp hgap

theorem inverse_distance_row151 (s : Finset ℕ) (m N : ℕ)
