        _ ≤ 6 * (max h ell : ℕ) * Real.log (m : ℝ) := hstep1
        _ ≤ 6 * (max h ell : ℕ) * Real.log (X : ℝ) := hstep2
        _ ≤ C * (max h ell : ℕ) * Real.log (X : ℝ) := by
