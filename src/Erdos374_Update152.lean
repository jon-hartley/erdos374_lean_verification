      (1 + L) * (∫ t in A..B + 1, ‖D t‖ ^ 2) +
        (1 / L) * (∫ t in A..B + 1, ‖D' t‖ ^ 2) := by
  have hF : Continuous (fun t => ‖D t‖ ^ 2) := hC.norm.pow 2
  have hF' : Continuous (fun t => ‖D' t‖ ^ 2) := hC'.norm.pow 2
