    have := (le_max_left Yb Ys).trans ((le_max_left _ _).trans hX)
    linarith
  have hXi := hi X ((le_max_right _ _).trans hX)
  have hback := hb (2 * X) hXb
  have hbound := forward_measure_bound151 hX1 hL hscale
  linarith

