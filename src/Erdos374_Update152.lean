      have hR :
          2 * (ℓ * (ℓ - 1) * (m - 1) / 2) =
            ℓ * (ℓ - 1) * (m - 1) :=
        Nat.two_mul_div_two_of_even
          (n := ℓ * (ℓ - 1) * (m - 1)) (h_even.mul_right (m - 1))
      have h_eq0 :
          2 * ((ℓ * (ℓ - 1) / 2) * (m - 1)) =
