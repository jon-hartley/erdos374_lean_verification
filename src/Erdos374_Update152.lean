theorem goodReductionForAnchor_proved :
    RemainingAnalytic28.GoodReductionForAnchor := by
  intro a r j t h ell hj hjr hh hell hth hnp hNS
  let H := max h ell
  let Λ := max (a + 1) (max (2 * r * H + 1) (64 * H ^ 2))
  refine ⟨Λ, ?_⟩
  intro lam hΛ hlam
  have ha1 : a + 1 ≤ lam := by
    exact le_trans (le_max_left (a + 1)
      (max (2 * r * H + 1) (64 * H ^ 2))) hΛ
  have htwo1 : 2 * r * H + 1 ≤ lam := by
    exact le_trans
      (le_trans
        (le_max_left (2 * r * H + 1) (64 * H ^ 2))
        (le_max_right (a + 1)
          (max (2 * r * H + 1) (64 * H ^ 2))))
      hΛ
  have h64 : 64 * H ^ 2 ≤ lam := by
    exact le_trans
      (le_trans
        (le_max_right (2 * r * H + 1) (64 * H ^ 2))
        (le_max_right (a + 1)
          (max (2 * r * H + 1) (64 * H ^ 2))))
      hΛ
  dsimp [H] at htwo1 h64 ⊢
  exact ⟨by omega, by omega, h64⟩

