      simp only [Polynomial.eval_mul, Polynomial.eval_pow, Polynomial.eval_X,
        mul_comm j q, pow_mul, hx_pow_q, Polynomial.eval_add, hrjk_div j,
        hsjk_div j, hx_pow]
