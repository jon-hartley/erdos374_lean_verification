/-- Eventually `6 m^η log m` lies below `m^(1-α)`. -/
theorem six_gaplog_lt_anchor_power
    {α η : ℝ} (hgap : η < 1 - α) :
    ∃ N : ℕ, ∀ m : ℕ, N ≤ m →
      6 * (m : ℝ) ^ η * Real.log (m : ℝ) <
        (m : ℝ) ^ (1 - α) := by
  let δ : ℝ := (1 - α) - η
  have hδ : 0 < δ := by dsimp [δ]; linarith
  have hlo :
      Real.log =o[atTop] (fun x : ℝ => x ^ δ) :=
    isLittleO_log_rpow_atTop hδ
  have hbR :
      ∀ᶠ x : ℝ in atTop,
        ‖Real.log x‖ ≤ (1 / 12 : ℝ) * ‖x ^ δ‖ :=
    hlo.def (by norm_num)
  have hbN :
      ∀ᶠ n : ℕ in atTop,
        ‖Real.log (n : ℝ)‖ ≤
          (1 / 12 : ℝ) * ‖(n : ℝ) ^ δ‖ :=
    tendsto_natCast_atTop_atTop.eventually hbR
  have htwo : ∀ᶠ n : ℕ in atTop, 2 ≤ n := eventually_ge_atTop 2
  have hall :
      ∀ᶠ n : ℕ in atTop,
        6 * (n : ℝ) ^ η * Real.log (n : ℝ) <
          (n : ℝ) ^ (1 - α) := by
    filter_upwards [hbN, htwo] with n hb hn
    have hn1 : (1 : ℝ) < n := by exact_mod_cast (show 1 < n by omega)
    have hnp : 0 < (n : ℝ) := by positivity
    have hlog : 0 < Real.log (n : ℝ) := Real.log_pos hn1
    have hδp : 0 < (n : ℝ) ^ δ := Real.rpow_pos_of_pos hnp _
    have hηp : 0 < (n : ℝ) ^ η := Real.rpow_pos_of_pos hnp _
    have hble :
        Real.log (n : ℝ) ≤ (1 / 12 : ℝ) * (n : ℝ) ^ δ := by
      simpa [Real.norm_eq_abs, abs_of_pos hlog, abs_of_pos hδp] using hb
    have hid :
        (n : ℝ) ^ η * (n : ℝ) ^ δ =
          (n : ℝ) ^ (1 - α) := by
      dsimp [δ]
      rw [← Real.rpow_add hnp]
      congr 1
      ring
    calc
      6 * (n : ℝ) ^ η * Real.log (n : ℝ)
          ≤ 6 * (n : ℝ) ^ η *
              ((1 / 12 : ℝ) * (n : ℝ) ^ δ) := by gcongr
      _ = (1 / 2 : ℝ) * (n : ℝ) ^ (1 - α) := by
            rw [← hid]
            ring
      _ < (n : ℝ) ^ (1 - α) := by
            have hp : 0 < (n : ℝ) ^ (1 - α) := Real.rpow_pos_of_pos hnp _
            nlinarith
  exact eventually_atTop.1 hall

/-- Small bottom indices are eventually also below the large prime. -/
theorem fixed_index_lt_anchor_power
    {α : ℝ} (hα : α < 1) (A : ℕ) :
    ∃ N : ℕ, ∀ m : ℕ, N ≤ m →
      (A : ℝ) < (m : ℝ) ^ (1 - α) := by
  have hexp : 0 < 1 - α := by linarith
  have ht :
      Tendsto (fun n : ℕ => (n : ℝ) ^ (1 - α))
        atTop atTop :=
    (tendsto_rpow_atTop hexp).comp tendsto_natCast_atTop_atTop
  have hev :
      ∀ᶠ m : ℕ in atTop, (A : ℝ) < (m : ℝ) ^ (1 - α) :=
    ht.eventually (eventually_gt_atTop (A : ℝ))
  exact eventually_atTop.1 hev

