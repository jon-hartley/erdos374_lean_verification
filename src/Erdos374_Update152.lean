          (anchorEvalMod a r j t h ell lam (z : ZMod lam)) := by
  classical
  unfold AnchorSquareResidueCount AnchorSquareResidues squareIndicator61
  have h :=
    card_filter_eq_sum_indicator61
      (Finset.range lam)
      (fun z : ℕ =>
        ModSquareOrZero
          (anchorEvalMod a r j t h ell lam (z : ZMod lam)))
