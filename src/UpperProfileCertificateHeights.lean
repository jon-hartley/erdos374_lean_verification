noncomputable def height (j : ℕ) : ℕ := if j<720 then lookup heights j else 0
theorem height_terminal : height 720 = 0 := by decide
theorem height_decreases : ∀ j : Fin 720, height (j.val+1) ≤ height j.val := by decide
theorem height_sum : (∑ j ∈ Finset.range 720, height j) = 24550929947512 := by decide
theorem area_bound : 500*(∑ j ∈ Finset.range 720, height j) < 307*40*scale := by decide
run_cmd do
  for decl in [``height_terminal, ``height_decreases, ``height_sum, ``area_bound] do
    for ax in (← Lean.collectAxioms decl) do
      unless ax == ``propext || ax == ``Classical.choice || ax == ``Quot.sound do
        throwError "Unexpected axiom {ax} in {decl}"
  Lean.logInfo "FINER PROFILE HEIGHTS AND EXACT AREA"
end UpperProfileCertificateData
